{
  "log": {
    "loglevel": "none"
  },
  "dns": {
    "hosts": {
      "cloudflare-dns.com": [
        "1.1.1.1",
        "1.0.0.1"
      ],
      "dns.google": [
        "8.8.8.8",
        "8.8.4.4"
      ]
    },
    "servers": [
      "https+local://cloudflare-dns.com/dns-query",
      "https+local://dns.google/dns-query"
    ],
    "queryStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "tag": "transparent-in",
      "listen": "0.0.0.0",
      "port": 50080,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "http-in",
      "listen": "0.0.0.0",
      "port": 7890,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "port": 7891,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "socks-1080-in",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "benchmark-in",
      "listen": "0.0.0.0",
      "port": 17890,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "dns-in",
      "listen": "0.0.0.0",
      "port": 7874,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "port": 53,
        "network": "tcp,udp"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "blocked-until-configured",
      "protocol": "blackhole",
      "settings": {}
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "ruleTag": "DNS",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "ruleTag": "BENCHMARK",
        "inboundTag": [
          "benchmark-in"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "Personal",
        "domain": [
          "domain:myteamspeak.ru",
          "domain:myteamspeak.com",
          "domain:papervpn.io",
          "domain:blancvpn.com",
          "domain:vpnguild.org",
          "domain:ghfast.top",
          "domain:habr.com",
          "domain:cleanvoice.ru",
          "domain:dreamerscast.com",
          "domain:saveeditor.online",
          "domain:movespeed.com",
          "domain:jamisbikes.com",
          "full:plata.careers"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "Ads",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ruleTag": "LAN",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ruleTag": "Russia exceptions",
        "domain": [
          "domain:avito.ru",
          "domain:perekrestok.ru"
