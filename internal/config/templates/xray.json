          "geosite:category-gov-ru",
          "geosite:category-ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ruleTag": "Russia IP",
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ruleTag": "Speedtest",
        "domain": [
          "geosite:speedtest",
          "geosite:ookla-speedtest",
          "geosite:category-speedtest"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "IP Check",
        "domain": [
          "domain:2ip.io",
          "domain:2ip.ru",
          "domain:ipinfo.io",
          "domain:ip-api.com",
          "domain:ip.sb",
          "domain:ipify.org",
          "domain:ident.me",
          "domain:icanhazip.com",
          "domain:ipleak.net",
          "domain:myip.com",
          "domain:myexternalip.com",
          "domain:whatismyip.com",
          "domain:whatismyipaddress.com"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "Google",
        "domain": [
          "geosite:google"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "YouTube",
        "domain": [
          "geosite:youtube"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
