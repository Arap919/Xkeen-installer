      },
      {
        "type": "field",
        "ruleTag": "Discord",
        "domain": [
          "keyword:discord"
        ],
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "Discord voice",
        "ip": [
          "34.0.192.0/18",
          "35.192.0.0/11",
          "66.22.192.0/18"
        ],
        "network": "udp",
        "port": "50000-50100",
        "outboundTag": "blocked-until-configured"
      },
      {
        "type": "field",
        "ruleTag": "Social",
        "domain": [
          "geosite:facebook",
          "geosite:instagram",
          "geosite:twitter",
          "geosite:x",
          "geosite:threads",
          "geosite:linkedin"
        ],
